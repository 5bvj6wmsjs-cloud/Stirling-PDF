    # Header
    draw.rounded_rectangle(
        (65, y+18, W-65, y+82),
        radius=18,
        fill="#EADDEC"
    )

    draw.text(
        (W//2, y+50),
        header,
        font=bold,
        anchor="mm",
        fill="#453548"
    )

    # Tasks
    yy = y + 105

    for line in lines:

        draw.text(
            (80, yy),
            line,
            font=regular,
            fill="#4C4650"
        )

